# ShedOS Branding Configuration for Calamares
# https://github.com/calamares/calamares/wiki/Deploy-Configuration#branding

componentName: shedos

strings:
    productName: "ShedOS"
    shortProductName: "ShedOS"
    version: "DEVELOPMENT"
    shortVersion: "DEVELOPMENT"
    versionedName: "ShedOS DEVELOPMENT"
    shortVersionedName: "ShedOS DEVELOPMENT"
    bootloaderEntryName: "ShedOS"
    productUrl: "https://github.com/theshedman/shedos"
    supportUrl: "https://github.com/theshedman/shedos/issues"
    knownIssuesUrl: "https://github.com/theshedman/shedos/issues"
    releaseNotesUrl: "https://github.com/theshedman/shedos/releases"
    donateUrl: ""
    welcome: "Welcome to ShedOS installer.<br/>Please connect to a power source if your battery is low.<br/>You may optionally connect to WiFi."

images:
    productLogo: "shedos-logo.png"
    productIcon: "icon.png"
    productWelcome: "shedos-logo.png"

slideshow: "show.qml"

# Catppuccin Mocha color scheme - Navigation/sidebar styling
style:
    SidebarBackground: "#1e1e2e"
    SidebarText: "#cdd6f4"
    SidebarTextCurrent: "#89b4fa"
    SidebarBackgroundCurrent: "#313244"
    SidebarTextHighlight: "#f38ba8"
    SidebarTextSelect: "#89b4fa"

# Use widget navigation (shows step list on sidebar)
navigation: widget

uploadServer:
    type: "none"
